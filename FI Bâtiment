let filtered = [...BATIMENTS];
let sortCol = 'nom';
let sortAsc = true;
let currentTab = 'batiments';

function badgeClass(statut) {
  if (!statut) return 'b-default';
  const s = statut.toUpperCase();
  if (s.includes('IMPLANTÉ')) return 'b-implante';
  if (s.includes('COLLECTE')) return 'b-collecte';
  if (s.includes('JAMAIS')) return 'b-jamais';
  if (s.includes('NON ADMISSIBLE')) return 'b-nonadmis';
  if (s.includes('INCONNU')) return 'b-inconnu';
  return 'b-autre';
}

function populateCommunautes() {
  const sel = document.getElementById('filterComm');
  const comms = {};
  BATIMENTS.forEach(b => { if (b.num_comm && b.communaute) comms[b.num_comm] = b.communaute; });
  Object.entries(comms).sort((a,b) => a[0]-b[0]).forEach(([code, nom]) => {
    const o = document.createElement('option');
    o.value = code;
    o.textContent = code + ' – ' + nom;
    sel.appendChild(o);
  });
}

function populateTypes() {
  const sel = document.getElementById('filterType');
  const types = [...new Set(BATIMENTS.map(b => b.type).filter(Boolean))].sort();
  types.forEach(t => {
    const o = document.createElement('option');
    o.value = t; o.textContent = t;
    sel.appendChild(o);
  });
}

function applyFilters() {
  const txt = document.getElementById('searchText').value.toLowerCase().trim();
  const comm = document.getElementById('filterComm').value;
  const formateur = document.getElementById('filterFormateur').value;
  const type = document.getElementById('filterType').value;
  const statut = document.getElementById('filterStatut').value;

  filtered = BATIMENTS.filter(b => {
    if (comm && String(b.num_comm) !== comm) return false;
    if (formateur && b.formateur !== formateur) return false;
    if (type && b.type !== type) return false;
    if (statut && b.statut !== statut) return false;
    if (txt) {
      const haystack = (b.nom + ' ' + b.adresse + ' ' + b.id_pge + ' ' + b.communaute).toLowerCase();
      if (!haystack.includes(txt)) return false;
    }
    return true;
  });

  updateKPIs();
  renderTable();
  renderContacts(comm);
}

function resetFilters() {
  document.getElementById('searchText').value = '';
  document.getElementById('filterComm').value = '';
  document.getElementById('filterFormateur').value = '';
  document.getElementById('filterType').value = '';
  document.getElementById('filterStatut').value = '';
  filtered = [...BATIMENTS];
  updateKPIs();
  renderTable();
  renderContacts('');
}

function updateKPIs() {
  const total = filtered.length;
  const implante = filtered.filter(b => b.statut === 'PGE IMPLANTÉ').length;
  const collecte = filtered.filter(b => b.statut === 'COLLECTE RÉALISÉE').length;
  const jamais = filtered.filter(b => b.statut === 'JAMAIS VISITÉ').length;
  const nonadmis = filtered.filter(b => b.statut === 'NON ADMISSIBLE').length;
  const rate = total > 0 ? (implante / total * 100).toFixed(1) + '%' : '–';
  document.getElementById('kTotal').textContent = total.toLocaleString('fr-CA');
  document.getElementById('kImplante').textContent = implante;
  document.getElementById('kCollecte').textContent = collecte;
  document.getElementById('kJamais').textContent = jamais;
  document.getElementById('kNonAdmis').textContent = nonadmis;
  document.getElementById('kRate').textContent = rate;
  document.getElementById('resultsCount').textContent = total.toLocaleString('fr-CA') + ' bâtiment' + (total !== 1 ? 's' : '') + ' trouvé' + (total !== 1 ? 's' : '');
}

function sortBy(col) {
  if (sortCol === col) sortAsc = !sortAsc;
  else { sortCol = col; sortAsc = true; }
  renderTable();
}

function renderTable() {
  const sorted = [...filtered].sort((a, b) => {
    let va = a[sortCol] ?? '';
    let vb = b[sortCol] ?? '';
    if (typeof va === 'number' && typeof vb === 'number') return sortAsc ? va - vb : vb - va;
    return sortAsc ? String(va).localeCompare(String(vb), 'fr') : String(vb).localeCompare(String(va), 'fr');
  });

  const tbody = document.getElementById('tableBody');
  const noRes = document.getElementById('noResults');
  if (sorted.length === 0) {
    tbody.innerHTML = '';
    noRes.style.display = 'block';
    return;
  }
  noRes.style.display = 'none';
  tbody.innerHTML = sorted.map(b => `
    <tr onclick="showDetail(${JSON.stringify(b).replace(/"/g,'&quot;')})">
      <td title="${b.communaute}">${b.communaute}</td>
      <td title="${b.nom}">${b.nom}</td>
      <td>${b.type || '–'}</td>
      <td><span class="badge ${badgeClass(b.statut)}">${b.statut || '–'}</span></td>
      <td>${b.formateur || '–'}</td>
      <td>${b.superficie ? b.superficie.toLocaleString('fr-CA', {maximumFractionDigits:0}) + ' m²' : '–'}</td>
      <td>${b.annee || '–'}</td>
    </tr>
  `).join('');
}

function renderContacts(commCode) {
  const grid = document.getElementById('contactsGrid');
  let cons = CONTACTS;
  if (commCode) {
    cons = CONTACTS.filter(c => c.communaute.startsWith(commCode + ' ') || c.communaute.startsWith(commCode + '-'));
  }
  if (cons.length === 0) {
    grid.innerHTML = '<div class="no-results" style="grid-column:1/-1">Aucun contact pour cette sélection</div>';
    return;
  }
  grid.innerHTML = cons.map(c => `
    <div class="contact-full-card">
      <div class="comm-label">${c.communaute}</div>
      <div class="contact-name">${c.nom}</div>
      <div class="contact-role">${c.role}</div>
      <div class="contact-info">
        ${c.email && c.email !== 'None' ? `<div>✉ <a href="mailto:${c.email}">${c.email}</a></div>` : ''}
        ${c.tel && c.tel !== 'None' ? `<div>📞 ${c.tel}</div>` : ''}
      </div>
    </div>
  `).join('');
}

function showDetail(b) {
  const panel = document.getElementById('detailPanel');
  document.getElementById('detailCode').textContent = b.code;
  document.getElementById('detailNom').textContent = b.nom;

  const comContacts = CONTACTS.filter(c => {
    const code = String(b.num_comm);
    return c.communaute.startsWith(code + ' ') || c.communaute.startsWith(code + '-');
  });

  document.getElementById('detailBody').innerHTML = `
    <div class="detail-section">
      <h3>Informations bâtiment</h3>
      <div class="detail-row"><span class="dl">Communauté</span><span class="dv">${b.communaute}</span></div>
      <div class="detail-row"><span class="dl">Type</span><span class="dv">${b.type || '–'}</span></div>
      <div class="detail-row"><span class="dl">Adresse</span><span class="dv">${b.adresse || '–'}</span></div>
      <div class="detail-row"><span class="dl">ID PGE</span><span class="dv">${b.id_pge || '–'}</span></div>
      <div class="detail-row"><span class="dl">Statut PGE</span><span class="dv"><span class="badge ${badgeClass(b.statut)}">${b.statut || '–'}</span></span></div>
      <div class="detail-row"><span class="dl">Superficie</span><span class="dv">${b.superficie ? b.superficie.toLocaleString('fr-CA', {maximumFractionDigits:0}) + ' m²' : '–'}</span></div>
      <div class="detail-row"><span class="dl">Année constr.</span><span class="dv">${b.annee || '–'}</span></div>
      <div class="detail-row"><span class="dl">Formateur</span><span class="dv">${b.formateur || '–'}</span></div>
    </div>
    <div class="detail-section">
      <h3>Contacts de la communauté (${comContacts.length})</h3>
      ${comContacts.length === 0 
        ? '<p style="color:#999;font-size:12px">Aucun contact répertorié</p>'
        : comContacts.map(c => `
          <div class="contact-card">
            <div class="contact-name">${c.nom}</div>
            <div class="contact-role">${c.role}</div>
            <div class="contact-info">
              ${c.email && c.email !== 'None' ? `<div>✉ <a href="mailto:${c.email}">${c.email}</a></div>` : ''}
              ${c.tel && c.tel !== 'None' ? `<div>📞 ${c.tel}</div>` : ''}
            </div>
          </div>`).join('')
      }
    </div>
  `;
  panel.classList.add('open');
}

function closeDetail() {
  document.getElementById('detailPanel').classList.remove('open');
}

function switchTab(tab, el) {
  currentTab = tab;
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('tabBatiments').style.display = tab === 'batiments' ? 'block' : 'none';
  document.getElementById('tabContacts').style.display = tab === 'contacts' ? 'block' : 'none';
}

function exportCSV() {
  const headers = ['Code','Communauté','Nom','Type','Adresse','ID PGE','Statut PGE','Formateur','Superficie (m²)','Année'];
  const rows = filtered.map(b => [
    b.code, b.communaute, b.nom, b.type, b.adresse || '', b.id_pge,
    b.statut, b.formateur, b.superficie || '', b.annee || ''
  ].map(v => '"' + String(v).replace(/"/g,'""') + '"').join(','));
  const csv = [headers.join(','), ...rows].join('\n');
  const blob = new Blob(['\uFEFF' + csv], {type:'text/csv;charset=utf-8'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'batiments_export.csv';
  a.click();
  URL.revokeObjectURL(url);
}

// Init
populateCommunautes();
populateTypes();
filtered = [...BATIMENTS];
updateKPIs();
renderTable();
renderContacts('');

document.getElementById('searchText').addEventListener('keydown', e => {
  if (e.key === 'Enter') applyFilters();
});
</script>
