        <option>Jean-Pierre Bergeron</option>
        <option>Patrick Giguère</option>
        <option>Non assigné</option>
      </select>
    </div>
    <div class="sidebar-section">
      <label>Type de bâtiment</label>
      <select id="filterType">
        <option value="">Tous les types</option>
      </select>
    </div>
    <div class="sidebar-section">
      <label>Statut PGE</label>
      <select id="filterStatut">
        <option value="">Tous les statuts</option>
        <option value="PGE IMPLANTÉ">PGE IMPLANTÉ</option>
        <option value="COLLECTE RÉALISÉE">COLLECTE RÉALISÉE</option>
        <option value="JAMAIS VISITÉ">JAMAIS VISITÉ</option>
        <option value="NON ADMISSIBLE">NON ADMISSIBLE</option>
        <option value="Inconnu">Inconnu</option>
        <option value="AUTRE">AUTRE</option>
        <option value="À déterminer">À déterminer</option>
        <option value="PGE PRÊT À IMPLANTER">PGE PRÊT À IMPLANTER</option>
      </select>
    </div>
    <div class="sidebar-section">
      <button class="btn-search" onclick="applyFilters()">🔍 Rechercher</button>
      <button class="btn-reset" onclick="resetFilters()">↺ Réinitialiser</button>
    </div>
  </div>

  <!-- Main -->
  <div class="main">
    <!-- KPIs -->
    <div class="kpi-bar" id="kpiBar">
      <div class="kpi"><div class="kpi-value" id="kTotal">-</div><div class="kpi-label">Total</div></div>
      <div class="kpi-sep"></div>
      <div class="kpi implante"><div class="kpi-value" id="kImplante">-</div><div class="kpi-label">PGE Implanté</div></div>
      <div class="kpi collecte"><div class="kpi-value" id="kCollecte">-</div><div class="kpi-label">Collecte</div></div>
      <div class="kpi jamais"><div class="kpi-value" id="kJamais">-</div><div class="kpi-label">Jamais visité</div></div>
      <div class="kpi nonadmis"><div class="kpi-value" id="kNonAdmis">-</div><div class="kpi-label">Non admissible</div></div>
      <div class="kpi-sep"></div>
      <div class="kpi-rate">Taux d'implantation : <span id="kRate">-</span></div>
    </div>

    <!-- Tabs -->
    <div class="tabs">
      <div class="tab active" onclick="switchTab('batiments', this)">Bâtiments</div>
      <div class="tab" onclick="switchTab('contacts', this)">Contacts</div>
    </div>

    <!-- Results -->
    <div class="results-area">
      <div class="results-header">
        <div class="results-count" id="resultsCount"></div>
        <button class="btn-export" onclick="exportCSV()">⬇ Exporter CSV</button>
      </div>
      <div id="tabBatiments">
        <table id="mainTable">
          <thead>
            <tr>
              <th onclick="sortBy('communaute')">Communauté ↕</th>
              <th onclick="sortBy('nom')">Nom du bâtiment ↕</th>
              <th onclick="sortBy('type')">Type ↕</th>
              <th onclick="sortBy('statut')">Statut PGE ↕</th>
              <th onclick="sortBy('formateur')">Formateur ↕</th>
              <th onclick="sortBy('superficie')">Superficie ↕</th>
              <th onclick="sortBy('annee')">Année ↕</th>
            </tr>
          </thead>
          <tbody id="tableBody"></tbody>
        </table>
        <div class="no-results" id="noResults" style="display:none">Aucun bâtiment ne correspond aux critères</div>
      </div>
      <div id="tabContacts" style="display:none">
        <div class="contacts-grid" id="contactsGrid"></div>
      </div>
    </div>
  </div>
</div>

<!-- Detail panel -->
<div class="detail-panel" id="detailPanel">
  <div class="detail-header">
    <div>
      <div style="font-size:10px;opacity:0.7;margin-bottom:4px" id="detailCode"></div>
      <h2 id="detailNom"></h2>
    </div>
    <button class="btn-close" onclick="closeDetail()">✕</button>
  </div>
  <div class="detail-body" id="detailBody"></div>
</div>

