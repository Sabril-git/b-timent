<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Suivi Bâtiments – Communautés R6</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: system-ui, sans-serif; background: #f5f5f2; color: #1a1a1a; font-size: 14px; }
  
  /* Header */
  .header { background: #1e3a2f; color: white; padding: 16px 24px; display: flex; align-items: center; gap: 12px; }
  .header h1 { font-size: 18px; font-weight: 600; }
  .header p { font-size: 12px; opacity: 0.7; margin-top: 2px; }

  /* Layout */
  .app { display: flex; height: calc(100vh - 60px); }
  .sidebar { width: 280px; background: white; border-right: 1px solid #e0e0e0; display: flex; flex-direction: column; flex-shrink: 0; }
  .main { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

  /* Sidebar */
  .sidebar-section { padding: 14px 16px; border-bottom: 1px solid #f0f0f0; }
  .sidebar-section label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: #666; display: block; margin-bottom: 6px; }
  .sidebar-section select, .sidebar-section input[type=text] { width: 100%; padding: 7px 10px; border: 1px solid #ddd; border-radius: 6px; font-size: 13px; background: #fafafa; color: #1a1a1a; }
  .sidebar-section select:focus, .sidebar-section input:focus { outline: 2px solid #1e3a2f; border-color: transparent; }
  .btn-search { width: 100%; padding: 9px; background: #1e3a2f; color: white; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; margin-top: 4px; }
  .btn-search:hover { background: #2d5a42; }
  .btn-reset { width: 100%; padding: 7px; background: none; color: #666; border: 1px solid #ddd; border-radius: 6px; font-size: 12px; cursor: pointer; margin-top: 6px; }
  .btn-reset:hover { background: #f5f5f5; }

  /* KPI bar */
  .kpi-bar { background: white; border-bottom: 1px solid #e0e0e0; padding: 10px 20px; display: flex; gap: 20px; align-items: center; flex-wrap: wrap; }
  .kpi { text-align: center; }
  .kpi-value { font-size: 22px; font-weight: 700; }
  .kpi-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em; color: #888; }
  .kpi.implante .kpi-value { color: #1e7e4a; }
  .kpi.collecte .kpi-value { color: #1565c0; }
  .kpi.jamais .kpi-value { color: #e67e22; }
  .kpi.nonadmis .kpi-value { color: #c0392b; }
  .kpi-sep { width: 1px; height: 36px; background: #eee; }
  .kpi-rate { font-size: 12px; color: #888; margin-left: auto; }
  .kpi-rate span { font-size: 18px; font-weight: 700; color: #1e3a2f; }

  /* Tabs */
  .tabs { display: flex; background: white; border-bottom: 1px solid #e0e0e0; }
  .tab { padding: 10px 20px; font-size: 13px; font-weight: 500; color: #666; cursor: pointer; border-bottom: 2px solid transparent; }
  .tab.active { color: #1e3a2f; border-bottom-color: #1e3a2f; }
  .tab:hover { color: #1e3a2f; }

  /* Results */
  .results-area { flex: 1; overflow: auto; padding: 16px 20px; }
  .results-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
  .results-count { font-size: 12px; color: #888; }
  .btn-export { padding: 6px 14px; background: white; border: 1px solid #ddd; border-radius: 5px; font-size: 12px; cursor: pointer; color: #1e3a2f; font-weight: 500; }
  .btn-export:hover { background: #f0f7f3; border-color: #1e3a2f; }

  /* Table */
  table { width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden; border: 1px solid #e8e8e8; font-size: 12.5px; }
  thead th { background: #f8f8f6; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: #555; padding: 9px 12px; text-align: left; border-bottom: 1px solid #e8e8e8; white-space: nowrap; cursor: pointer; user-select: none; }
  thead th:hover { background: #efefea; }
  tbody tr { border-bottom: 1px solid #f2f2f2; cursor: pointer; }
  tbody tr:hover { background: #f0f7f3; }
  tbody td { padding: 8px 12px; color: #333; max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* Badge statut */
  .badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 10.5px; font-weight: 600; white-space: nowrap; }
  .b-implante { background: #d4edda; color: #155724; }
  .b-collecte { background: #cce5ff; color: #004085; }
  .b-jamais { background: #fff3cd; color: #856404; }
  .b-nonadmis { background: #f8d7da; color: #721c24; }
  .b-inconnu { background: #e2e3e5; color: #383d41; }
  .b-autre { background: #e2e3e5; color: #383d41; }
  .b-default { background: #e2e3e5; color: #383d41; }

  /* Detail panel */
  .detail-panel { position: fixed; right: 0; top: 0; width: 360px; height: 100vh; background: white; box-shadow: -4px 0 20px rgba(0,0,0,0.12); z-index: 100; display: none; flex-direction: column; overflow: hidden; }
  .detail-panel.open { display: flex; }
  .detail-header { background: #1e3a2f; color: white; padding: 16px 20px; display: flex; justify-content: space-between; align-items: flex-start; }
  .detail-header h2 { font-size: 14px; font-weight: 600; line-height: 1.4; }
  .btn-close { background: none; border: none; color: white; font-size: 20px; cursor: pointer; padding: 0; line-height: 1; opacity: 0.8; }
  .btn-close:hover { opacity: 1; }
  .detail-body { flex: 1; overflow-y: auto; padding: 16px 20px; }
  .detail-section { margin-bottom: 16px; }
  .detail-section h3 { font-size: 10px; text-transform: uppercase; letter-spacing: 0.07em; color: #999; margin-bottom: 8px; font-weight: 600; }
  .detail-row { display: flex; padding: 5px 0; border-bottom: 1px solid #f5f5f5; font-size: 12.5px; }
  .detail-row .dl { color: #888; width: 120px; flex-shrink: 0; }
  .detail-row .dv { color: #1a1a1a; font-weight: 500; flex: 1; }
  .contact-card { background: #f8f8f6; border-radius: 7px; padding: 10px 12px; margin-bottom: 8px; }
  .contact-name { font-weight: 600; font-size: 13px; margin-bottom: 3px; }
  .contact-role { color: #666; font-size: 11px; margin-bottom: 5px; }
  .contact-info { font-size: 11.5px; color: #1565c0; }
  .contact-info a { color: #1565c0; text-decoration: none; }
  .contact-info a:hover { text-decoration: underline; }
  .no-results { text-align: center; padding: 60px; color: #999; }

  /* Contacts tab */
  .contacts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .contact-full-card { background: white; border: 1px solid #e8e8e8; border-radius: 8px; padding: 12px; }
  .comm-label { font-size: 10px; color: #999; margin-bottom: 4px; }
</style>
</head>
